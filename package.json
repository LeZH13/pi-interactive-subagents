{
  "name": "pi-interactive-subagents",
  "version": "3.7.2",
  "description": "Interactive subagents for pi - spawn, orchestrate, and manage sub-agent sessions in tmux",
  "keywords": [
    "pi-package"
  ],
  "license": "MIT",
  "author": "Amos Blomqvist",
  "repository": {
    "type": "git",
    "url": "https://github.com/amosblomqvist/pi-interactive-subagents"
  },
  "type": "module",
  "scripts": {
    "test": "node --test test/test.ts",
    "test:unit": "node --test test/test.ts",
    "test:tmux": "node --test test/integration/tmux-surface.test.ts",
    "test:integration": "node --test --test-concurrency=1 test/integration/*.test.ts",
    "test:coverage": "node --test --experimental-test-coverage test/test.ts",
    "typecheck": "tsc --noEmit --pretty false"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": ">=0.87.0",
    "@earendil-works/pi-tui": ">=0.87.0",
    "@sinclair/typebox": "*"
  },
  "pi": {
    "extensions": [
      "./pi-extension/subagents/index.ts"
    ]
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "0.87.1",
    "@earendil-works/pi-tui": "0.87.1",
    "@sinclair/typebox": "^0.34.49",
    "@types/node": "^26.6.2",
    "typescript": "^5.9.3"
  }
}
